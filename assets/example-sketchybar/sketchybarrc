#!/usr/bin/env lua

local source = debug.getinfo(1, "S").source
local config_dir = source:sub(1, 1) == "@" and source:sub(2):match("(.+)/[^/]+$") or "."

package.path = table.concat({
  config_dir .. "/?.lua",
  config_dir .. "/?/init.lua",
  config_dir .. "/?/?.lua",
  package.path,
}, ";")

local sbar = require("sketchybar")
local init = require("init")

sbar.begin_config()
init.setup(sbar, config_dir)
sbar.end_config()

init.refresh()

if os.getenv("SKETCHYBAR_TEST_MODE") ~= "1" then
  sbar.event_loop()
end
